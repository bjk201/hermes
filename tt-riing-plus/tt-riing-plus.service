# ─────────────────────────────────────────────
# systemd Service für Thermaltake Riing Plus Control
# Installation: sudo cp tt-riing-plus.service /etc/systemd/system/
# Enable:  sudo systemctl enable --now tt-riing-plus.service
# Status:  sudo systemctl status tt-riing-plus.service
# Stop:    sudo systemctl stop tt-riing-plus.service
# Restart: sudo systemctl restart tt-riing-plus.service
# Logs:    journalctl -u tt-riing-plus.service -f
# ─────────────────────────────────────────────
[Unit]
Description=Thermaltake Riing Plus RGB Control GUI
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
# Pfad zur App — anpassen falls nötig
ExecStart=/home/bjk201/Downloads/tt-Ring-plus/tt-riing-plus.sh
WorkingDirectory=/home/bjk201/Downloads/tt-Ring-plus

# Environment für Qt/X11/Wayland
Environment=DISPLAY=:0
# QT_QPA_PLATFORM=auto (X11 oder Wayland automatisch erkennen)

# Restart-Verhalten
Restart=on-failure
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tt-riing-plus

[Install]
WantedBy=graphical-session.target
